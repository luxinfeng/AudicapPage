---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Payment Successful - Audicap"
  description="Your payment was successful. Thank you for purchasing Audicap credits."
  canonical=""
  hreflangs={[]}
>

  

<section class="success-page">
<div class="container">
<div class="success-content">
<div class="success-icon">✓</div>
<h1>Payment Successful!</h1>
<p class="success-message">Thank you for your purchase. Your credits have been added to your account.</p>
<div class="order-details">
<h2>Order Details</h2>
<div class="detail-row">
<span class="detail-label">Transaction ID:</span>
<span class="detail-value" id="transaction-id">Loading...</span>
</div>
<div class="detail-row">
<span class="detail-label">Credits Purchased:</span>
<span class="detail-value" id="credits-amount">Loading...</span>
</div>
<div class="detail-row">
<span class="detail-label">Amount Paid:</span>
<span class="detail-value" id="amount-paid">Loading...</span>
</div>
<div class="detail-row">
<span class="detail-label">Date:</span>
<span class="detail-value" id="purchase-date">Loading...</span>
</div>
</div>
<div class="next-steps">
<h2>What's Next?</h2>
<ul>
<li>Your credits are now available in your Audicap extension</li>
<li>Open the extension to start transcribing audio</li>
<li>Credits expire 30 days after purchase</li>
<li>A confirmation email has been sent to your registered email address</li>
</ul>
</div>
<div class="success-actions">
<a class="btn btn-primary" href="/">Back to Home</a>
<a class="btn btn-secondary" href="mailto:support@audicap.work">Contact Support</a>
</div>
<div class="refund-notice">
<p>Need a refund? Review our <a href="/refund.html">Refund Policy</a> for eligibility and instructions.</p>
</div>
</div>
</div>
</section>



</Layout>
