---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  hreflangs?: { lang: string; url: string }[];
}

const { title, description, canonical, hreflangs = [] } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  {canonical && <link rel="canonical" href={canonical} />}
  {hreflangs.map((h) => (
    <link rel="alternate" hreflang={h.lang} href={h.url} />
  ))}

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical || "https://audicap.work/"}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content="https://audicap.work/og-share.png">
  <meta property="og:site_name" content="Audicap">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content="https://audicap.work/og-share.png">

  <slot name="head" />

  <link rel="stylesheet" href="/style.css">
  <link rel="icon" type="image/png" sizes="128x128" href="/favicon-128.png">
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon.png">
</head>
<body class={Astro.url.pathname === '/' ? 'home-page' : ''}>
  {Astro.url.pathname === '/' ? (
    <header class="site-header" role="banner">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label="Audicap home">
          <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <span class="brand-name">Audicap<small>Learning capture</small></span>
        </a>
        <nav class="primary-nav" aria-label="Main navigation">
          <a href="/#workflow">How it works</a>
          <a href="/use-cases/">Use cases</a>
          <a href="/#pricing">Pricing</a>
          <a href="/blog/">Guides</a>
        </nav>
        <a class="header-cta" href="https://chromewebstore.google.com/detail/audicap/cfalkkjbhiohkomajlelefmllnoniloo?utm_source=audicap_website&amp;utm_medium=seo&amp;utm_campaign=home_header">Add to Chrome <span aria-hidden="true">↗</span></a>
      </div>
    </header>
  ) : (
    <header>
      <div class="container">
        <a href="/" class="logo">🎧 Audicap</a>
        <nav aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/use-cases/">For Learners</a>
          <a href="/blog/">Guides</a>
          <a href="/#pricing">Pricing</a>
        </nav>
      </div>
    </header>
  )}

  <main>
    <slot />
  </main>

  {Astro.url.pathname === '/' ? (
    <footer class="site-footer" role="contentinfo">
      <div class="container footer-layout">
        <div class="footer-brand"><a href="/" class="brand" aria-label="Audicap home"><span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span class="brand-name">Audicap<small>Learning capture</small></span></a><p>Live transcription for professional learning in Chrome.</p></div>
        <div class="footer-column"><strong>Product</strong><a href="/#product">Overview</a><a href="/#workflow">How it works</a><a href="/#pricing">Pricing</a><a href="/use-cases/">Use cases</a></div>
        <div class="footer-column"><strong>Resources</strong><a href="/blog/">Guides</a><a href="/alternatives/">Alternatives</a><a href="/use-cases/professional-learning.html">Professional learning</a><a href="mailto:support@audicap.work">Contact</a></div>
        <div class="footer-column"><strong>Company</strong><a href="/privacy.html">Privacy</a><a href="/terms.html">Terms</a><a href="/refund.html">Refund policy</a></div>
      </div>
      <div class="container footer-bottom"><span>© 2026 Audicap. All rights reserved.</span><span>Built for the work of learning.</span></div>
    </footer>
  ) : (
    <footer>
      <div class="container">
        <div class="footer-links">
          <a href="/privacy.html">Privacy Policy</a>
          <a href="/terms.html">Terms of Service</a>
          <a href="/refund.html">Refund Policy</a>
          <a href="/blog/">Guides</a>
          <a href="/use-cases/">For Learners</a>
          <a href="/alternatives/">Alternatives</a>
        </div>
        <p class="footer-copyright">© 2026 Audicap. All rights reserved.</p>
      </div>
    </footer>
  )}

  <!-- Google Analytics (GA4) -->
  <script defer src="https://www.googletagmanager.com/gtag/js?id=G-04VJZMNQV9"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){window.dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-04VJZMNQV9');
    document.addEventListener('click', function(event) {
      var link = event.target.closest && event.target.closest('a[href*="chromewebstore.google.com"]');
      if (!link) return;
      var destination = new URL(link.href);
      gtag('event', 'chrome_web_store_click', {
        campaign: destination.searchParams.get('utm_campaign') || 'unknown',
        link_text: link.textContent.trim()
      });
    });
  </script>

  <!-- Microsoft Clarity -->
  <script type="text/javascript" is:inline>
    window.addEventListener('DOMContentLoaded', function() {
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window,document,"clarity","script","xdkqvqf653");
    });
  </script>
</body>
</html>
